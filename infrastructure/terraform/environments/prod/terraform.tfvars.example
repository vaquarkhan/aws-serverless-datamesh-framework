# Copy to terraform.tfvars and customize bucket names (must be globally unique).

aws_region   = "us-east-2"
environment  = "prod"
name_prefix  = "sdm-prod"

checkpoint_bucket_name = "sdm-prod-checkpoints-YOUR_ACCOUNT_ID"
proof_bucket_name      = "sdm-prod-proofs-YOUR_ACCOUNT_ID"
lakehouse_bucket_name  = "sdm-prod-lakehouse-YOUR_ACCOUNT_ID"

glue_database_name = "raw_orders"
glue_table_name    = "orders_curated"
domain_id          = "orders-domain"

enable_durable_execution    = true
enable_step_functions       = true
enable_eventbridge_schedule = false
enable_monitoring_alarms    = true
create_ops_sns_topic        = true
# Confirm subscription emails after apply (AWS sends a Confirm subscription link):
ops_alert_emails            = ["ops@example.com"]
# ops_alert_https_endpoints = ["https://hooks.slack.com/services/XXX/YYY/ZZZ"]
trust_dashboard_domains     = ["orders", "payments", "inventory"]

# enable_lake_formation_governance = true
# consumer_principal_arn = "arn:aws:iam::123456789012:role/athena-consumer"

lambda_timeout_seconds              = 600   # 10 min segments in this example
# Workload clock: set to your backfill wall-clock
durable_execution_timeout_seconds   = 3600
durable_retention_days              = 14
lambda_memory_mb                    = 2048
max_resume_attempts                 = 8
sfn_invoke_timeout_buffer_seconds   = 60
resume_wait_seconds                 = 30

# Longer production backfills (uncomment / override):
# lambda_timeout_seconds            = 900   # 15 min on-demand
# durable_execution_timeout_seconds = 10800 # set to whatever your job needs
# lambda_memory_mb                  = 4096
# max_resume_attempts               = 14

# Optional Lambda Managed Instances (up to 90 min async/ESM segments):
# enable_lambda_managed_instances                = true
# lambda_managed_instances_capacity_provider_arn = "arn:aws:lambda:us-east-2:ACCOUNT:capacity-provider:NAME"
# lambda_timeout_seconds                         = 5400
# Required when lambda_timeout_seconds > 900 and you use Step Functions:
# sfn_lambda_invoke_mode                         = "async_callback"
# (sync SFN invoke remains AWS-capped at 15 min)

# Optional: also page an existing platform topic
# alarm_sns_topic_arns = ["arn:aws:sns:us-east-2:123456789012:platform-alerts"]

# Networking (default = NO VPC — Lambda on AWS-managed network, not account default VPC)
# lambda_subnet_ids         = ["subnet-aaa", "subnet-bbb"]
# lambda_security_group_ids = ["sg-cccc"]
# IAM: Terraform creates {name_prefix}-domain-writer + Step Functions roles automatically.
# When subnets are set, AWSLambdaVPCAccessExecutionRole is already attached.
