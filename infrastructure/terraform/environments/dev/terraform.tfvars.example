aws_region = "us-east-2"
name_prefix = "sdm-dev"
checkpoint_bucket_name = "sdm-dev-checkpoints-ACCOUNT_ID"
proof_bucket_name      = "sdm-dev-proofs-ACCOUNT_ID"
lakehouse_bucket_name  = "sdm-dev-lakehouse-ACCOUNT_ID"

# Shorter example timeouts (override in terraform.tfvars or -var)
lambda_timeout_seconds            = 600
# Workload clock: set to your backfill wall-clock (IceGuard + Durable protect Iceberg)
durable_execution_timeout_seconds = 3600
# Optional LMI: enable_lambda_managed_instances = true (+ capacity provider ARN)
# After Design tab "Save & generate pipelines", contract lives at mesh.yaml beside generated/:
#   serverless-data-mesh apply --contract ../path/to/mesh.yaml --output ../path/to/generated
# Terraform deploys the packaged Lambda zip (lambda_package_path), not the YAML directly.
lambda_memory_mb                  = 2048
